{
  "name": "poe2-abyss-overlay",
  "version": "0.4.0",
  "private": true,
  "description": "Overlay showing eligible Abyss Desecration modifier pools for copied Path of Exile 2 items.",
  "license": "MIT",
  "author": "slapinskiDEV",
  "homepage": "https://github.com/slapinskiDEV/abyss-craft-overlay-poe2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slapinskiDEV/abyss-craft-overlay-poe2.git"
  },
  "bugs": {
    "url": "https://github.com/slapinskiDEV/abyss-craft-overlay-poe2/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/update-repoe.ts",
    "data:inspect": "tsx scripts/inspect-snapshot.ts",
    "data:evidence": "tsx scripts/fetch-wiki-evidence.ts",
    "data:normalize": "tsx scripts/normalize-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:diff": "tsx scripts/semantic-diff.ts",
    "data:update": "tsx scripts/update-data.ts",
    "i18n:validate": "tsx scripts/validate-translations.ts",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "verify:release": "tsx scripts/verify-release.ts",
    "package:scan": "tsx scripts/scan-artifact.ts",
    "icon": "tsx scripts/make-icon.ts",
    "package:win": "npm run verify:release && npm run build && npm run package:scan && electron-builder --win"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "i18next": "^26.4.2",
    "koffi": "2.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "main": "out/main/main.js"
}
